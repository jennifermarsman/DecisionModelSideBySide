# Copy this file to .env and fill in your values.

# --- Azure OpenAI (left panel) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Microsoft-Decision-1 in Microsoft Foundry (right panel) ---
# Your Foundry resource endpoint; the app calls <endpoint>/providers/microsoft/v1/systemone
DECISION_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com
# Optional: leave empty to use Microsoft Entra ID (az login / managed identity) instead of a key
DECISION_API_KEY=
# The deployment name (not the underlying model name)
DECISION_DEPLOYMENT=microsoft-decision-1

# Set to true to try the UI without any Azure resources (simulated classifiers and latency).
MOCK_MODELS=false

# PORT=5000
